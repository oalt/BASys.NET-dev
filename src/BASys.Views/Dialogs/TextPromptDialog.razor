<DialogFrame Title="@ViewModel.Title" Width="400px">
    <div class="form-row">
        <label>@ViewModel.Message</label>
        <input type="text" class="form-control form-control-sm" @ref="_focusElement" @bind="Text" @bind:event="oninput" @onkeydown="OnKeyDown" />
    </div>
    <div class="button-row">
        <button type="button" class="btn btn-sm btn-primary" @onclick="OnOk">@ViewModel.OkText</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnCancel">@ViewModel.CancelText</button>
    </div>
</DialogFrame>
